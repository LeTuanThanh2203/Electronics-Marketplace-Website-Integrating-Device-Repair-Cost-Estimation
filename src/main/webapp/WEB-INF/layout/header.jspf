<%--
    Unified Architectural Header matching index/home.jsp standard.
    Controls:
      ${pageTitle}: Custom page title
      ${activeNav}: 'home' | 'product' | 'new' | 'marketplace' | 'used' | 'repair' | 'cart' | 'auth' | 'admin'
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<c:set var="cartCount" value="${not empty sessionScope.cart and not empty sessionScope.cart.items ? fn:length(sessionScope.cart.items) : 0}" />
<c:set var="currentUser" value="${sessionScope.currentUser}" />
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${empty pageTitle ? 'ELECTRONICSMARKETPLACE — Nền Tảng Thiết Bị & Sửa Chữa Tiêu Chuẩn' : pageTitle}</title>

    <!-- Google Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface": "#f9f9f7", "surface-dim": "#dadad8", "surface-container-lowest": "#ffffff",
            "surface-container-low": "#f4f4f2", "surface-container": "#eeeeec", "surface-container-high": "#e8e8e6",
            "on-surface": "#1a1c1b", "on-surface-variant": "#444748", "outline": "#747878",
            "primary": "#000000", "on-primary": "#ffffff", "primary-container": "#1c1b1b",
            "brand-orange": "#FF4A1C", "brand-black": "#0B0B0B", "brand-border": "#E5E5E5", "brand-card": "#F8F8F8", "brand-gray": "#666666"
          },
          fontFamily: {
            "sans": ["Be Vietnam Pro", "sans-serif"],
            "mono": ["JetBrains Mono", "monospace"],
            "space": ["Space Grotesk", "sans-serif"]
          }
        }
      }
    };
    </script>

    <!-- Core Stylesheets -->
    <link rel="stylesheet" href="${ctx}/css/style.css">
    <link rel="stylesheet" href="${ctx}/css/home.css">
    <link rel="stylesheet" href="${ctx}/css/listing.css">
    <link rel="stylesheet" href="${ctx}/css/repair.css">
    <link rel="stylesheet" href="${ctx}/css/order.css">
    <link rel="stylesheet" href="${ctx}/css/auth.css">
    <link rel="stylesheet" href="${ctx}/css/admin.css">
</head>
<body class="bg-surface font-sans text-on-surface antialiased flex flex-col min-h-screen">

<!-- MASTER FIXED TOP HEADER -->
<header class="fixed top-0 left-0 right-0 z-50 bg-surface-container-lowest border-b border-surface-dim transition-all">
    <div class="max-w-[1440px] mx-auto px-4 md:px-8 lg:px-12 h-16 flex items-center justify-between gap-4">
        
        <!-- Left: Brand Logo & Main Nav -->
        <div class="flex items-center gap-6 lg:gap-8 shrink-0">
            <a class="text-[17px] font-space font-extrabold tracking-wider uppercase text-primary flex items-center gap-2 hover:opacity-90 transition-opacity" href="${ctx}/home">
                <span class="w-3.5 h-3.5 bg-[#FF4A1C] inline-block shrink-0"></span>
                <span>ELECTRONICSMARKETPLACE</span>
            </a>
            
            <nav class="hidden md:flex items-center h-16 gap-1 lg:gap-2 font-sans text-[13px] uppercase tracking-wider font-semibold">
                <a class="h-full inline-flex items-center px-3 text-on-surface-variant hover:text-primary border-b-2 ${activeNav == 'new' || activeNav == 'product' ? 'border-[#FF4A1C] text-primary font-bold' : 'border-transparent'} transition-colors" 
                   href="${ctx}/product/list">LAPTOP MỚI</a>
                <a class="h-full inline-flex items-center px-3 text-on-surface-variant hover:text-primary border-b-2 ${activeNav == 'used' || activeNav == 'marketplace' ? 'border-[#FF4A1C] text-primary font-bold' : 'border-transparent'} transition-colors" 
                   href="${ctx}/listing/marketplace">CHỢ ĐỒ CŨ</a>
                <a class="h-full inline-flex items-center px-3 text-on-surface-variant hover:text-primary border-b-2 ${activeNav == 'repair' ? 'border-[#FF4A1C] text-primary font-bold' : 'border-transparent'} transition-colors" 
                   href="${ctx}/repair/request">SỬA CHỮA</a>
            </nav>
        </div>

        <!-- Middle: Dynamic Module Actions (Search & Quick Navigation) -->
        <div class="flex-1 max-w-md hidden md:flex items-center justify-center px-2">
            <c:choose>
                <%-- Product Search Slot --%>
                <c:when test="${activeNav == 'product' || activeNav == 'new'}">
                    <form action="${ctx}/products" method="GET" class="relative flex items-center w-full border border-surface-dim bg-surface-container-low focus-within:border-primary transition-colors">
                        <input type="hidden" name="action" value="search">
                        <span class="material-symbols-outlined text-outline ml-2.5 text-[18px]">search</span>
                        <input class="w-full bg-transparent px-2.5 py-1.5 text-xs font-sans text-primary placeholder:text-outline focus:outline-none" 
                               name="q" value="${searchKeyword}" placeholder="Tìm laptop mới, GPU, CPU..." type="text">
                    </form>
                </c:when>

                <%-- Marketplace Search Slot --%>
                <c:when test="${activeNav == 'marketplace' || activeNav == 'used'}">
                    <form action="${ctx}/listing/marketplace" method="GET" class="relative flex items-center w-full border border-surface-dim bg-surface-container-low focus-within:border-primary transition-colors">
                        <span class="material-symbols-outlined text-outline ml-2.5 text-[18px]">search</span>
                        <input class="w-full bg-transparent px-2.5 py-1.5 text-xs font-sans text-primary placeholder:text-outline focus:outline-none" 
                               name="keyword" value="${param.keyword}" placeholder="Tìm trong chợ đồ cũ C2C..." type="text">
                    </form>
                </c:when>

                <%-- Repair Sub-actions Slot --%>
                <c:when test="${activeNav == 'repair'}">
                    <div class="flex items-center gap-2">
                        <a href="${ctx}/repair/track" class="inline-flex items-center gap-1 px-3 py-1 bg-surface-container-low border border-surface-dim hover:border-primary text-xs font-mono font-medium text-primary uppercase transition-colors">
                            <span class="material-symbols-outlined text-sm">troubleshoot</span>
                            <span>TRA CỨU TIẾN ĐỘ SỬA</span>
                        </a>
                        <a href="${ctx}/repair/request" class="inline-flex items-center gap-1 px-3 py-1 bg-primary text-white hover:bg-[#FF4A1C] hover:text-black text-xs font-mono font-medium uppercase transition-colors">
                            <span class="material-symbols-outlined text-sm">build</span>
                            <span>DỰ TOÁN CHI PHÍ</span>
                        </a>
                    </div>
                </c:when>
            </c:choose>
        </div>

        <!-- Right: Action Controls (AI Recommendation Button, Cart, User Session) -->
        <div class="flex items-center gap-3 shrink-0">
            <%-- AI Recommendation Button (Product Module) --%>
            <c:if test="${activeNav == 'product' || activeNav == 'new'}">
                <button type="button" onclick="if(typeof toggleRecModal==='function'){toggleRecModal();}else{window.location.href='${ctx}/products?action=list';}" 
                        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary text-white hover:bg-[#FF4A1C] hover:text-black text-xs font-mono font-bold uppercase tracking-wider transition-colors border border-primary">
                    <span class="material-symbols-outlined text-sm text-[#FF4A1C]">auto_awesome</span>
                    <span>AI GỢI Ý MÁY</span>
                </button>
            </c:if>

            <%-- Sell Laptop Button (Marketplace Module) --%>
            <c:if test="${activeNav == 'marketplace' || activeNav == 'used'}">
                <a href="${ctx}/listing/form" 
                   class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#FF4A1C] text-black font-bold text-xs uppercase tracking-wider hover:brightness-110 transition-all border border-[#FF4A1C] shadow-sm">
                    <span class="material-symbols-outlined text-sm">add_circle</span>
                    <span>ĐĂNG BÁN MÁY</span>
                </a>
            </c:if>

            <%-- Shopping Cart Icon & Badge --%>
            <a class="relative w-9 h-9 border border-surface-dim flex items-center justify-center hover:border-primary text-primary transition-colors bg-surface-container-lowest" 
               href="${ctx}/cart" title="Giỏ hàng">
                <span class="material-symbols-outlined text-[19px]">shopping_bag</span>
                <c:if test="${cartCount > 0}">
                    <span class="absolute -top-1.5 -right-1.5 w-4 h-4 bg-[#FF4A1C] text-black font-mono font-extrabold text-[10px] rounded-full flex items-center justify-center leading-none">
                        ${cartCount}
                    </span>
                </c:if>
            </a>

            <%-- User Authentication Status --%>
            <c:choose>
                <c:when test="${not empty currentUser}">
                    <div class="flex items-center gap-2">
                        <a class="flex items-center gap-1.5 h-9 px-2.5 border border-surface-dim bg-surface-container-lowest hover:border-primary text-primary transition-colors text-xs font-semibold" 
                           href="${ctx}/profile" title="Hồ sơ cá nhân">
                            <c:choose>
                                <c:when test="${not empty currentUser.avatar}">
                                    <img src="<c:url value='${currentUser.avatar}'/>" alt="avatar" class="w-5 h-5 rounded-full object-cover border border-[#FF4A1C]">
                                </c:when>
                                <c:otherwise>
                                    <span class="w-5 h-5 rounded-full bg-primary text-white font-mono text-[10px] flex items-center justify-center">
                                        ${currentUser.initial}
                                    </span>
                                </c:otherwise>
                            </c:choose>
                            <span class="hidden xl:inline max-w-[100px] truncate">${currentUser.name}</span>
                        </a>

                        <c:if test="${currentUser.admin}">
                            <a class="h-9 px-2.5 bg-amber-100 border border-amber-300 text-amber-800 hover:bg-amber-200 transition-colors text-xs font-mono font-bold uppercase flex items-center gap-1" 
                               href="${ctx}/admin" title="Bảng quản trị">
                                <span class="material-symbols-outlined text-sm">shield_person</span>
                                <span class="hidden sm:inline">Admin</span>
                            </a>
                        </c:if>

                        <a class="w-9 h-9 border border-surface-dim bg-surface-container-lowest hover:border-red-500 text-red-600 flex items-center justify-center transition-colors" 
                           href="${ctx}/logout" title="Đăng xuất">
                            <span class="material-symbols-outlined text-[18px]">logout</span>
                        </a>
                    </div>
                </c:when>
                <c:otherwise>
                    <a class="flex items-center gap-1.5 h-9 px-3 bg-primary text-white hover:bg-[#FF4A1C] hover:text-black text-xs font-mono font-bold uppercase tracking-wider transition-colors" 
                       href="${ctx}/login">
                        <span class="material-symbols-outlined text-[17px]">person</span>
                        <span>Đăng nhập</span>
                    </a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>

<!-- MAIN CONTAINER WITH TOP PADDING TO AVOID FIXED HEADER OVERLAP -->
<main class="w-full pt-16 flex-1 flex flex-col">