<%--
    Fragment header dung chung cho module Cart / Order / Payment.
    KHONG khai bao page/taglib o day: trang goi tu khai bao (static include).
    Trang con set ${pageTitle} va ${activeNav} truoc khi include.

    LUU Y tich hop: ${sessionScope.currentUser} va ${sessionScope.cart} la ten
    attribute gia dinh theo Rule 3 (Session chi chua current User + Cart).
    Neu Tan dat ten khac trong AuthenticationFilter thi sua 2 dong duoi day.
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<c:set var="cartCount" value="${not empty sessionScope.cart and not empty sessionScope.cart.items ? fn:length(sessionScope.cart.items) : 0}" />
<c:set var="currentUser" value="${sessionScope.currentUser}" />
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${empty pageTitle ? 'Sửa hay bán' : pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="${ctx}/css/order.css">
</head>
<body>

<header class="site-header">
    <div class="container">
        <a class="brand" href="${ctx}/home">Sửa hay bán</a>

        <nav class="site-nav">
            <a href="${ctx}/product?action=list">Mua mới</a>
            <a href="${ctx}/listing?action=marketplace" class="${activeNav == 'marketplace' ? 'active' : ''}">Chợ đồ cũ</a>
            <a href="${ctx}/repair?action=form">Sửa chữa</a>
        </nav>

        <div class="header-actions">
            <c:choose>
                <c:when test="${empty currentUser}">
                    <a href="${ctx}/login" class="btn btn-ghost btn-sm">Đăng nhập</a>
                    <a href="${ctx}/register" class="btn btn-primary btn-sm">Đăng ký</a>
                </c:when>
                <c:otherwise>
                    <a href="${ctx}/order?action=history" class="btn btn-ghost btn-sm">Đơn hàng của tôi</a>
                </c:otherwise>
            </c:choose>
            <a class="cart-link" href="${ctx}/cart">
                Giỏ hàng
                <c:if test="${cartCount > 0}">
                    <span class="cart-count">${cartCount}</span>
                </c:if>
            </a>
        </div>
    </div>
</header>

<main class="container">
