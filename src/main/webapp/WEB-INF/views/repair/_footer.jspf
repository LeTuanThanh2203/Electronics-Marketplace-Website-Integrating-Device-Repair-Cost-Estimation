<%--
    Unified Architectural Footer for Repair Module (Quốc)
    Synchronized with Index Stitch Design System (home.jsp)
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />

<footer class="w-full bg-[#050505] text-white border-t border-zinc-800 mt-16 font-sans">
    <div class="max-w-[1440px] mx-auto px-4 md:px-8 lg:px-12 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 border-b border-zinc-800/80 pb-8 mb-8">
            <div class="flex flex-col gap-2">
                <a class="text-[17px] font-space font-extrabold text-white tracking-wider uppercase flex items-center gap-2" href="${ctx}/home">
                    <span class="w-3.5 h-3.5 bg-[#FF4A1C] inline-block shrink-0"></span>
                    <span>ELECTRONICSMARKETPLACE</span>
                </a>
                <p class="text-[12px] text-zinc-400 mt-2 leading-relaxed font-sans">
                    Nền tảng thương mại điện tử &amp; kỹ thuật tiêu chuẩn. Tích hợp định giá sửa chữa tức thì, chợ laptop cũ C2C kiểm định và máy mới chính hãng B2C.
                </p>
                <div class="flex items-center gap-2 mt-2 text-xs font-mono text-zinc-500">
                    <span class="text-[#FF4A1C]">●</span>
                    <span>100% HARDWARE VERIFIED · LAB TIÊU CHUẨN</span>
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <span class="text-[11px] font-mono uppercase tracking-widest text-zinc-500 mb-1 font-semibold">DANH MỤC TRỌNG TÂM</span>
                <a href="${ctx}/product/list" class="text-[13px] text-zinc-300 hover:text-[#FF4A1C] transition-colors uppercase font-medium">Laptop Mới Chính Hãng</a>
                <a href="${ctx}/listing/marketplace" class="text-[13px] text-zinc-300 hover:text-[#FF4A1C] transition-colors uppercase font-medium">Chợ Đồ Cũ C2C Minh Bạch</a>
                <a href="${ctx}/repair/request" class="text-[13px] text-zinc-300 hover:text-[#FF4A1C] transition-colors uppercase font-medium">Dịch Vụ Sửa Chữa &amp; Báo Giá</a>
                <a href="${ctx}/cart" class="text-[13px] text-zinc-300 hover:text-[#FF4A1C] transition-colors uppercase font-medium">Giỏ Hàng Điện Tử</a>
            </div>

            <div class="flex flex-col gap-2">
                <span class="text-[11px] font-mono uppercase tracking-widest text-zinc-500 mb-1 font-semibold">HỖ TRỢ &amp; HỆ THỐNG</span>
                <a href="${ctx}/order" class="text-[13px] text-zinc-300 hover:text-[#FF4A1C] transition-colors uppercase font-medium">Tra Cứu Đơn Mua Hàng</a>
                <a href="${ctx}/repair/track" class="text-[13px] text-zinc-300 hover:text-[#FF4A1C] transition-colors uppercase font-medium">Tra Cứu Tiến Độ Sửa Chữa</a>
                <a href="${ctx}/admin" class="text-[13px] text-zinc-300 hover:text-[#FF4A1C] transition-colors uppercase font-medium">Bảng Quản Trị Hệ Thống (Admin)</a>
                <a href="${ctx}/profile" class="text-[13px] text-zinc-300 hover:text-[#FF4A1C] transition-colors uppercase font-medium">Hồ Sơ &amp; Bảo Mật Tài Khoản</a>
            </div>

            <div class="flex flex-col gap-2">
                <span class="text-[11px] font-mono uppercase tracking-widest text-zinc-500 mb-1 font-semibold">LIÊN HỆ &amp; HỖ TRỢ</span>
                <span class="text-[16px] font-mono font-bold text-[#FF4A1C]">HOTLINE: 1900 8888</span>
                <span class="text-[12px] text-zinc-400">Giờ làm việc: 08:00 – 21:00 (T2 – CN)</span>
                <span class="text-[12px] text-zinc-400">Email: support@electronics.vn</span>
                <span class="text-[12px] text-zinc-400">Trạm kỹ thuật: Khu Công Nghệ Cao, TP.HCM</span>
            </div>
        </div>

        <div class="flex flex-col md:flex-row items-center justify-between gap-4 font-mono text-[10px] text-zinc-500 uppercase tracking-widest">
            <div>© 2026 ELECTRONICSMARKETPLACE. NỀN TẢNG TIÊU CHUẨN ISO 9001:2015.</div>
            <div>STITCH ARCHITECTURAL DESIGN SYSTEM · ALL RIGHTS RESERVED</div>
        </div>
    </div>
</footer>
