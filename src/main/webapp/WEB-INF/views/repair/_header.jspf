<%--
    Unified Header for Repair Module (Quốc)
    Synchronized with Index Stitch Design System
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<c:set var="cartCount" value="${not empty sessionScope.cart and not empty sessionScope.cart.items ? fn:length(sessionScope.cart.items) : 0}" />
<c:set var="currentUser" value="${sessionScope.currentUser}" />

<!-- Google Icons & Tailwind for Unified Navbar & Footer -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>

<!-- FIXED TOP HEADER -->
<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-surface-dim transition-all">
    <div class="max-w-[1440px] mx-auto px-4 md:px-8 lg:px-12 h-16 flex items-center justify-between gap-4">
        
        <!-- Left: Brand Logo & Main Nav -->
        <div class="flex items-center gap-6 lg:gap-8 shrink-0">
            <a class="text-[17px] font-space font-extrabold tracking-wider uppercase text-primary flex items-center gap-2 hover:opacity-90 transition-opacity" href="${ctx}/home">
                <span class="w-3.5 h-3.5 bg-[#FF4A1C] inline-block shrink-0"></span>
                <span>ELECTRONICSMARKETPLACE</span>
            </a>
            
            <nav class="hidden md:flex items-center h-16 gap-1 lg:gap-2 font-sans text-[13px] uppercase tracking-wider font-semibold">
                <a class="h-full inline-flex items-center px-3 text-on-surface-variant hover:text-primary border-b-2 border-transparent transition-colors" 
                   href="${ctx}/product/list">LAPTOP MỚI</a>
                <a class="h-full inline-flex items-center px-3 text-on-surface-variant hover:text-primary border-b-2 border-transparent transition-colors" 
                   href="${ctx}/listing/marketplace">CHỢ ĐỒ CŨ</a>
                <a class="h-full inline-flex items-center px-3 text-primary border-b-2 border-[#FF4A1C] font-bold transition-colors" 
                   href="${ctx}/repair/request">SỬA CHỮA</a>
            </nav>
        </div>

        <!-- Middle: Repair Module Specific Functions -->
        <div class="hidden md:flex items-center gap-2">
            <a href="${ctx}/repair/track" 
               class="inline-flex items-center gap-1.5 px-3 py-1.5 ${rpPage == 'track' ? 'bg-primary text-white' : 'bg-surface-container-low text-primary border border-surface-dim'} hover:border-primary text-xs font-mono font-medium uppercase transition-colors">
                <span class="material-symbols-outlined text-sm">troubleshoot</span>
                <span>TRA CỨU TIẾN ĐỘ SỬA</span>
            </a>
            <a href="${ctx}/repair/request" 
               class="inline-flex items-center gap-1.5 px-3 py-1.5 ${rpPage == 'request' ? 'bg-[#FF4A1C] text-black font-bold' : 'bg-surface-container-low text-primary border border-surface-dim'} hover:bg-[#FF4A1C] hover:text-black text-xs font-mono font-medium uppercase transition-colors">
                <span class="material-symbols-outlined text-sm">build</span>
                <span>DỰ TOÁN CHI PHÍ</span>
            </a>
        </div>

        <!-- Right: Actions (Cart & Auth) -->
        <div class="flex items-center gap-3 shrink-0">
            <!-- Giỏ Hàng -->
            <a class="relative w-9 h-9 border border-surface-dim flex items-center justify-center hover:border-primary text-primary transition-colors bg-white" 
               href="${ctx}/cart" title="Giỏ hàng">
                <span class="material-symbols-outlined text-[19px]">shopping_bag</span>
                <c:if test="${cartCount > 0}">
                    <span class="absolute -top-1.5 -right-1.5 w-4 h-4 bg-[#FF4A1C] text-black font-mono font-extrabold text-[10px] rounded-full flex items-center justify-center leading-none">
                        ${cartCount}
                    </span>
                </c:if>
            </a>

            <!-- User Auth -->
            <c:choose>
                <c:when test="${not empty currentUser}">
                    <div class="flex items-center gap-2">
                        <a class="flex items-center gap-1.5 h-9 px-2.5 border border-surface-dim bg-white hover:border-primary text-primary transition-colors text-xs font-semibold" 
                           href="${ctx}/profile" title="Hồ sơ cá nhân">
                            <span class="w-5 h-5 rounded-full bg-primary text-white font-mono text-[10px] flex items-center justify-center">
                                ${currentUser.initial}
                            </span>
                            <span class="hidden xl:inline max-w-[100px] truncate">${currentUser.name}</span>
                        </a>

                        <c:if test="${currentUser.admin}">
                            <a class="h-9 px-2.5 bg-amber-100 border border-amber-300 text-amber-800 hover:bg-amber-200 transition-colors text-xs font-mono font-bold uppercase flex items-center gap-1" 
                               href="${ctx}/admin" title="Bảng quản trị">
                                <span class="material-symbols-outlined text-sm">shield_person</span>
                                <span class="hidden sm:inline">Admin</span>
                            </a>
                        </c:if>

                        <a class="w-9 h-9 border border-surface-dim bg-white hover:border-red-500 text-red-600 flex items-center justify-center transition-colors" 
                           href="${ctx}/logout" title="Đăng xuất">
                            <span class="material-symbols-outlined text-[18px]">logout</span>
                        </a>
                    </div>
                </c:when>
                <c:otherwise>
                    <a class="flex items-center gap-1.5 h-9 px-3 bg-primary text-white hover:bg-[#FF4A1C] hover:text-black text-xs font-mono font-bold uppercase tracking-wider transition-colors" 
                       href="${ctx}/login">
                        <span class="material-symbols-outlined text-[17px]">person</span>
                        <span>Đăng nhập</span>
                    </a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>

<!-- SPACER FOR FIXED HEADER -->
<div class="h-16"></div>

<!-- REPAIR BREADCRUMB STRIP -->
<div class="rp-breadcrumb">
    <div class="rp-breadcrumb__inner">
        <div>
            <a href="${ctx}/home">Trang chủ</a>
            <span class="rp-breadcrumb__sep">/</span>
            <a href="${ctx}/repair/request">Sửa chữa</a>
            <span class="rp-breadcrumb__sep">/</span>
            <span class="rp-breadcrumb__current"><c:out value="${rpCrumb}" /></span>
        </div>
        <div class="font-mono text-xs font-semibold text-zinc-500 uppercase tracking-widest">HỆ THỐNG LAB MINH BẠCH 100%</div>
    </div>
</div>
