<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">

    <!--
        Thong tin ket noi KHONG dat o day. Gia tri that duoc nap tu bien moi
        truong DB_URL / DB_USER / DB_PASSWORD qua JpaConfig.connectionOverrides()
        (xem config/JpaConfig.java) - override map luon thang gia tri trong file,
        nen placeholder duoi day chi la duong lui cho truong hop chay bang
        -DDB_URL=... ma khong qua JpaConfig.

        Luu y: Hibernate 6.4.4 KHONG ho tro cu phap ${env.DB_URL} (nem
        HHH10001004: No JDBC URL specified). Chi ${TEN_SYSTEM_PROPERTY} moi
        duoc thay the, nen viec doc bien moi truong bat buoc phai lam o Java.
    -->
    <persistence-unit name="Electronics_MarketplacePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <!-- Khong khai bao <class> va khong bat exclude-unlisted-classes: de
             Hibernate tu quet @Entity trong classpath. -->
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="${DB_URL}"/>
            <property name="jakarta.persistence.jdbc.user" value="${DB_USER}"/>
            <property name="jakarta.persistence.jdbc.password" value="${DB_PASSWORD}"/>

            <!-- Tu tao/cap nhat bang theo Entity -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!-- Batch processing -->
            <property name="hibernate.jdbc.batch_size" value="50"/>
            <property name="hibernate.order_inserts" value="true"/>
            <property name="hibernate.order_updates" value="true"/>
            <!-- Connection pool HikariCP -->
            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.hikari.minimumIdle" value="2"/>
            <property name="hibernate.hikari.connectionTimeout" value="10000"/>
        </properties>
    </persistence-unit>

    <!-- Unit phu: chi dung 1 lan luc khoi dong de tao database neu chua co -->
    <persistence-unit name="adminPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="${DB_URL}"/>
            <property name="jakarta.persistence.jdbc.user" value="${DB_USER}"/>
            <property name="jakarta.persistence.jdbc.password" value="${DB_PASSWORD}"/>
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
            <property name="hibernate.hikari.maximumPoolSize" value="2"/>
            <property name="hibernate.hikari.minimumIdle" value="1"/>
        </properties>
    </persistence-unit>
</persistence>
